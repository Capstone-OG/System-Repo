# =====================================================================
# V-Eval System-Wide Environment Variables
# =====================================================================
# Copy this file to .env at project root (/data/Capstone/.env):
#   cp .env.example .env
#
# Gemini API Key (Bắt buộc cho trích xuất khung chương trình SGK & sinh câu hỏi)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Tùy chọn: Google API Key (Tự động đồng bộ với GEMINI_API_KEY)
GOOGLE_API_KEY=

# Tùy chọn: OpenAI API Key (Dùng làm phương án dự phòng khi Gemini quá tải)
OPENAI_API_KEY=

