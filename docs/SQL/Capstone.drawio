<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Trang-1" id="auWYUtTMlVOIGT_nZTb6">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml VACT_SCHEMA_V4_ERD\n' =====================================================================\n' V-ACT PLATFORM \u2014 ERD CHU\u1ea8N V4 (Information Engineering / crow's-foot)\n' B\u1ea3n gom nh\u00f3m 9 Bounded Contexts \u0111\u1ed3ng b\u1ed9 100% CSDL Supabase &amp; Microservices\n' =====================================================================\n!define PK(x) &lt;b&gt;* x&lt;/b&gt;\n!define FK(x) x\n\nhide methods\nhide stereotypes\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam shadowing false\n\npackage \&quot;1. \u0110\u1ecbnh danh &amp; RBAC\&quot; #F0F4FF {\n  entity Campuses {\n    PK(campus_id) : uuid\n    --\n    code : varchar(50)\n    name : varchar(255)\n    address : varchar(500)\n    phone : varchar(50)\n    is_active : boolean\n    created_at : timestamp\n  }\n\n  entity Roles {\n    PK(role_id) : uuid\n    --\n    role_name : varchar(50)\n  }\n\n  entity UserRoles {\n    PK(user_id) : uuid\n    PK(role_id) : uuid\n    --\n  }\n\n  entity Users {\n    PK(user_id) : uuid\n    --\n    email : varchar(255)\n    password_hash : text\n    full_name : varchar(255)\n    phone : varchar(50)\n    avatar_url : text\n    is_active : boolean\n    created_at : timestamp\n  }\n\n  entity RefreshTokens {\n    PK(refresh_token_id) : uuid\n    --\n    FK(user_id) : uuid\n    token : varchar(500)\n    expires_at : timestamp\n    is_revoked : boolean\n    created_at : timestamp\n  }\n\n  entity OtpVerifications {\n    PK(id) : uuid\n    --\n    email : varchar(255)\n    otp_code : varchar(10)\n    type : varchar(50)\n    expires_at : timestamp\n    is_used : boolean\n    created_at : timestamp\n  }\n\n}\n\npackage \&quot;2. H\u1ed3 s\u01a1 Actor\&quot; #FFF6E9 {\n  entity Students {\n    PK(student_id) : uuid\n    --\n    FK(campus_id) : uuid\n    target_score : integer\n    exam_date : date\n    study_hours_day : double\n    school_name : varchar(255)\n    created_at : timestamp\n  }\n\n  entity Parents {\n    PK(parent_id) : uuid\n    --\n    phone_work : varchar(50)\n    created_at : timestamp\n  }\n\n  entity ParentStudentRelations {\n    PK(relation_id) : uuid\n    --\n    FK(parent_id) : uuid\n    FK(student_id) : uuid\n    created_at : timestamp\n  }\n\n  entity Teachers {\n    PK(teacher_id) : uuid\n    --\n    FK(campus_id) : uuid\n    specialty : varchar(255)\n    bio : text\n    created_at : timestamp\n  }\n\n  entity AcademicManagers {\n    PK(manager_id) : uuid\n    --\n    FK(campus_id) : uuid\n    created_at : timestamp\n  }\n\n  entity AcademicDirectors {\n    PK(director_id) : uuid\n    --\n    created_at : timestamp\n  }\n\n  entity Administrators {\n    PK(admin_id) : uuid\n    --\n    created_at : timestamp\n  }\n\n}\n\npackage \&quot;3. Khung n\u0103ng l\u1ef1c &amp; Ng\u00e2n h\u00e0ng c\u00e2u h\u1ecfi\&quot; #EAF7EC {\n  entity CompetencyDomains {\n    PK(domain_id) : uuid\n    --\n    name : text\n    description : text\n  }\n\n  entity Skills {\n    PK(skill_id) : uuid\n    --\n    FK(domain_id) : uuid\n    name : text\n    FK(parent_id) : uuid\n    weight : double\n    created_at : timestamp\n  }\n\n  entity SkillPrerequisites {\n    PK(skill_id) : uuid\n    PK(prerequisite_id) : uuid\n    --\n  }\n\n  entity Materials {\n    PK(material_id) : uuid\n    --\n    FK(skill_id) : uuid\n    title : text\n    content : text\n    video_url : text\n    file_url : text\n    duration_seconds : integer\n    created_at : timestamp\n  }\n\n  entity Passages {\n    PK(passage_id) : uuid\n    --\n    title : text\n    content : text\n    image_url : text\n  }\n\n  entity Questions {\n    PK(question_id) : uuid\n    --\n    FK(skill_id) : uuid\n    FK(passage_id) : uuid\n    difficulty_level : integer\n    content_latex : text\n    option_a : text\n    option_b : text\n    option_c : text\n    option_d : text\n    correct_option : character(1)\n    explanation : text\n    created_at : timestamp\n  }\n\n}\n\npackage \&quot;4. Thi th\u1eed &amp; Gi\u00e1m s\u00e1t li\u00eam ch\u00ednh\&quot; #FDEBEB {\n  entity MockExams {\n    PK(exam_id) : uuid\n    --\n    title : text\n    duration_minutes : integer\n    total_questions : integer\n    is_published : boolean\n    exam_category : text\n    subject_code : text\n    difficulty_level : integer\n    created_at : timestamp\n  }\n\n  entity ExamQuestions {\n    PK(exam_id) : uuid\n    PK(question_id) : uuid\n    --\n    question_order : integer\n  }\n\n  entity ExamSubmissions {\n    PK(submission_id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(exam_id) : uuid\n    exam_type : varchar(50)\n    total_score : integer\n    total_correct : integer\n    total_questions : integer\n    total_time_spent_seconds : integer\n    started_at : timestamp\n    completed_at : timestamp\n    status : varchar(50)\n    theta_0 : double\n    placement_class : varchar(50)\n    ai_commentary : text\n    FK(enrolled_class_id) : uuid\n    tab_departure_count : integer\n    integrity_status : varchar(50)\n    mentor_verdict : varchar(50)\n    mentor_notes : text\n  }\n\n  entity SubmissionAnswers {\n    PK(answer_id) : uuid\n    --\n    FK(submission_id) : uuid\n    FK(question_id) : uuid\n    selected_option : varchar(10)\n    is_correct : boolean\n    time_spent_seconds : integer\n  }\n\n  entity ProctoringSnapshots {\n    PK(id) : uuid\n    --\n    FK(submission_id) : uuid\n    snapshot_url : text\n    captured_at : timestamp\n    face_detected : boolean\n  }\n\n}\n\npackage \&quot;5. L\u1edbp h\u1ecdc &amp; Nh\u00f3m vi m\u00f4\&quot; #EEF0FF {\n  entity Classes {\n    PK(class_id) : uuid\n    --\n    FK(campus_id) : uuid\n    FK(teacher_id) : uuid\n    FK(assigned_by) : uuid\n    name : text\n    status : varchar(50)\n    assigned_at : timestamp\n    created_at : timestamp\n    class_type : integer\n    cluster_index : integer\n    domain_code : varchar(50)\n    FK(domain_id) : uuid\n  }\n\n  entity ClassEnrollments {\n    PK(enrollment_id) : uuid\n    --\n    FK(class_id) : uuid\n    FK(student_id) : uuid\n    FK(diagnostic_submission_id) : uuid\n    FK(approved_by) : uuid\n    status : varchar(50)\n    enrolled_at : timestamp\n  }\n\n  entity ClassGroups {\n    PK(group_id) : uuid\n    --\n    FK(class_id) : uuid\n    group_name : varchar(255)\n    focus_area : varchar(255)\n    common_weak_skill_ids : text\n    recommended_worksheet_title : varchar(255)\n    assigned_worksheet_id : varchar(100)\n    assigned_worksheet_title : varchar(255)\n    worksheet_assigned_at : timestamp\n    created_at : timestamp\n  }\n\n  entity ClassGroupMembers {\n    PK(group_member_id) : uuid\n    --\n    FK(group_id) : uuid\n    FK(student_id) : uuid\n    joined_at : timestamp\n  }\n\n    }\n\npackage \&quot;6. L\u1ed9 tr\u00ecnh th\u00edch \u1ee9ng &amp; Chu tr\u00ecnh P-L-A-R\&quot; #FFF0F6 {\n  entity LearningRoadmaps {\n    PK(roadmap_id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(diagnostic_submission_id) : uuid\n    target_score : integer\n    total_milestones : integer\n    completed_milestones : integer\n    is_pruned : boolean\n    pruned_reason : text\n    status : varchar(50)\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n  entity RoadmapNodes {\n    PK(node_id) : uuid\n    --\n    FK(roadmap_id) : uuid\n    FK(skill_id) : uuid\n    step_order : integer\n    FK(material_id) : uuid\n    FK(quiz_exam_id) : uuid\n    status : varchar(50)\n    is_pruned : boolean\n    unlocked_at : timestamp\n    completed_at : timestamp\n    video_watched_seconds : integer\n    video_total_seconds : integer\n    is_video_completed : boolean\n    quiz_score : double\n    is_quiz_passed : boolean\n  }\n\n  entity StageProgress {\n    PK(id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(roadmap_node_id) : uuid\n    current_step : varchar(50)\n    video_watch_percentage : numeric(5,2)\n    bkt_mastery_plt : double\n    consecutive_advanced_correct : integer\n    consecutive_incorrect : integer\n    status : varchar(50)\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n  entity LearningProfiles {\n    PK(profile_id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(skill_id) : uuid\n    mastery_score : double\n    last_updated : timestamp\n  }\n\n  entity AdaptiveQuizAttempts {\n    PK(id) : uuid\n    --\n    FK(stage_progress_id) : uuid\n    FK(student_id) : uuid\n    FK(question_id) : uuid\n    pattern_id : varchar(100)\n    selected_option : varchar(10)\n    is_correct : boolean\n    time_spent_seconds : integer\n    item_difficulty_b : double\n    item_discrimination_a : double\n    is_lucky_guess : boolean\n    prior_plt : double\n    posterior_plt : double\n    created_at : timestamp\n  }\n\n  entity MistakeNotebooks {\n    PK(id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(question_id) : uuid\n    FK(skill_id) : uuid\n    pattern_id : varchar(100)\n    cognitive_error_tag : varchar(50)\n    student_notes : text\n    next_review_date : date\n    review_count : integer\n    consecutive_correct_reviews : integer\n    interval_days : integer\n    ease_factor : double\n    is_mastered : boolean\n    last_reviewed_at : timestamp\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n}\n\npackage \&quot;7. AI Tutor &amp; Graph RAG Tri th\u1ee9c\&quot; #EAF6F8 {\n  entity KnowledgeSources {\n    PK(source_id) : uuid\n    --\n    domain_id : varchar(100)\n    skill_id : varchar(100)\n    title : varchar(255)\n    file_url : varchar(500)\n    file_hash : varchar(64)\n    document_type : varchar(50)\n    total_pages : integer\n    total_chars : integer\n    total_chunks : integer\n    vector_status : varchar(50)\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n  entity KnowledgeVectorChunks {\n    PK(chunk_id) : uuid\n    --\n    FK(source_id) : uuid\n    FK(domain_id) : varchar(100)\n    FK(skill_id) : varchar(100)\n    chunk_index : integer\n    page_number : integer\n    content_snippet : text\n    embedding : vector(768)\n    document_type : varchar(50)\n    char_count : integer\n    metadata : jsonb\n    created_at : timestamp\n  }\n\n  entity archetype_patterns {\n    PK(id) : uuid\n    --\n    FK(skill_id) : uuid\n    pattern_code : varchar(100)\n    pattern_name : varchar(255)\n    description : text\n    core_theorems : text\n    fast_solving_heuristics : text\n    embedding : vector(3072)\n    is_verified : boolean\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n  entity pattern_exemplars {\n    PK(id) : uuid\n    --\n    FK(archetype_pattern_id) : uuid\n    question_latex : text\n    golden_solution : text\n    correct_option : varchar(10)\n    explanation_steps : jsonb\n    created_at : timestamp\n  }\n\n  entity pattern_traps {\n    PK(id) : uuid\n    --\n    FK(archetype_pattern_id) : uuid\n    trap_code : varchar(100)\n    trap_name : varchar(255)\n    wrong_option : varchar(10)\n    misconception_explanation : text\n    socratic_hint : text\n    created_at : timestamp\n  }\n\n  entity novel_pattern_proposals {\n    PK(id) : uuid\n    --\n    source_exam_name : varchar(255)\n    raw_question_latex : text\n    image_urls : jsonb\n    extracted_metadata : jsonb\n    max_similarity_score : double\n    FK(nearest_archetype_id) : uuid\n    status : varchar(30)\n    academic_feedback : text\n    created_at : timestamp\n  }\n\n  entity ai_tutor_interaction_logs {\n    PK(id) : uuid\n    --\n    FK(student_id) : uuid\n    FK(question_id) : uuid\n    FK(archetype_pattern_id) : uuid\n    student_selected_option : varchar(10)\n    correct_option : varchar(10)\n    FK(matched_trap_id) : uuid\n    ai_guidance_transcript : jsonb\n    validation_status : varchar(20)\n    student_reported : boolean\n    mentor_resolution : text\n    created_at : timestamp\n  }\n\n}\n\npackage \&quot;8. D\u1ef1 b\u00e1o \u0111i\u1ec3m &amp; C\u1ea3nh b\u00e1o s\u1edbm BR-04\&quot; #FFF8E1 {\n  entity ScorePredictions {\n    PK(prediction_id) : uuid\n    --\n    FK(student_id) : uuid\n    predicted_score : integer\n    predicted_score_min : integer\n    predicted_score_max : integer\n    confidence_rate : double\n    target_score : integer\n    deficit_score : integer\n    sem_score : double\n    prescription_items : jsonb\n    calculation_source : varchar(50)\n    created_at : timestamp\n  }\n\n  entity SystemAlerts {\n    PK(alert_id) : uuid\n    --\n    FK(student_id) : uuid\n    alert_type : varchar(50)\n    message : text\n    is_read : boolean\n    FK(handled_by) : uuid\n    resolution_notes : text\n    resolved_at : timestamp\n    created_at : timestamp\n  }\n\n}\n\npackage \&quot;9. Ph\u00e2n t\u00edch h\u1ecdc t\u1eadp &amp; Ma tr\u1eadn nhi\u1ec7t (Analytics)\&quot; #E8F8F5 {\n  entity ClassSkillHeatmaps {\n    PK(id) : uuid\n    --\n    FK(class_id) : uuid\n    FK(student_id) : uuid\n    FK(skill_id) : uuid\n    skill_name : varchar(255)\n    domain_code : varchar(50)\n    plt_value : double\n    mastery_level : varchar(30)\n    last_assessment_type : varchar(50)\n    updated_at : timestamp\n  }\n\n  entity ClassHeatmapSummaries {\n    PK(id) : uuid\n    --\n    FK(class_id) : uuid\n    FK(skill_id) : uuid\n    skill_name : varchar(255)\n    domain_code : varchar(50)\n    average_plt : double\n    struggling_count : integer\n    total_students : integer\n    struggling_rate : double\n    std_dev_plt : double\n    alert_status : varchar(30)\n    is_bimodal : boolean\n    calculated_at : timestamp\n  }\n\n  entity StudentDailyActivities {\n    PK(id) : uuid\n    --\n    FK(student_id) : uuid\n    activity_date : date\n    study_time_minutes : integer\n    practice_questions_solved : integer\n    video_minutes_watched : integer\n    mock_exams_taken : integer\n    is_streak_counted : boolean\n    is_frozen : boolean\n    created_at : timestamp\n    updated_at : timestamp\n  }\n\n  entity StudentReadinessMetrics {\n    PK(id) : uuid\n    --\n    FK(student_id) : uuid\n    normalized_theta : double\n    skill_coverage_plt : double\n    consistency_score : double\n    exam_readiness_index : double\n    readiness_tier : varchar(30)\n    study_hours_this_week : double\n    current_streak_days : integer\n    calculated_at : timestamp\n  }\n\n}\n\n' RELATIONSHIPS\nUsers                     ||--o{ UserRoles\nRoles                     ||--o{ UserRoles\nUsers                     ||--o{ RefreshTokens\nUsers                     ||--o{ OtpVerifications\nUsers                     ||--o| Students\nUsers                     ||--o| Parents\nUsers                     ||--o| Teachers\nUsers                     ||--o| AcademicManagers\nUsers                     ||--o| AcademicDirectors\nUsers                     ||--o| Administrators\nCampuses                  ||--o{ Students\nCampuses                  ||--o{ Teachers\nCampuses                  ||--o{ AcademicManagers\nCampuses                  ||--o{ Classes\nParents                   ||--o{ ParentStudentRelations\nStudents                  ||--o{ ParentStudentRelations\nCompetencyDomains         ||--o{ Skills\nSkills                    |o--o{ Skills\nSkills                    ||--o{ SkillPrerequisites\nSkills                    ||--o{ Materials\nSkills                    ||--o{ Questions\nPassages                  |o--o{ Questions\nMockExams                 ||--o{ ExamQuestions\nQuestions                 ||--o{ ExamQuestions\nTeachers                  |o--o{ Classes\nAcademicManagers          |o--o{ Classes\nClasses                   ||--o{ ClassEnrollments\nStudents                  ||--o{ ClassEnrollments\nClasses                   ||--o{ ClassGroups\nClassGroups               ||--o{ ClassGroupMembers\nStudents                  ||--o{ ClassGroupMembers\nStudents                  ||--o{ LearningRoadmaps\nExamSubmissions           |o--o| LearningRoadmaps\nExamSubmissions           |o--o| ClassEnrollments\nLearningRoadmaps          ||--o{ RoadmapNodes\nSkills                    ||--o{ RoadmapNodes\nMaterials                 |o--o{ RoadmapNodes\nMockExams                 |o--o{ RoadmapNodes\nRoadmapNodes              ||--o{ StageProgress\nStudents                  ||--o{ StageProgress\nStudents                  ||--o{ LearningProfiles\nSkills                    ||--o{ LearningProfiles\nStageProgress             ||--o{ AdaptiveQuizAttempts\nStudents                  ||--o{ AdaptiveQuizAttempts\nQuestions                 ||--o{ AdaptiveQuizAttempts\nStudents                  ||--o{ MistakeNotebooks\nQuestions                 ||--o{ MistakeNotebooks\nSkills                    ||--o{ MistakeNotebooks\nStudents                  ||--o{ ExamSubmissions\nMockExams                 ||--o{ ExamSubmissions\nExamSubmissions           ||--o{ SubmissionAnswers\nQuestions                 ||--o{ SubmissionAnswers\nExamSubmissions           ||--o{ ProctoringSnapshots\nStudents                  ||--o{ ScorePredictions\nStudents                  ||--o{ SystemAlerts\nUsers                     |o--o{ SystemAlerts\nClasses                   ||--o{ ClassSkillHeatmaps\nStudents                  ||--o{ ClassSkillHeatmaps\nSkills                    ||--o{ ClassSkillHeatmaps\nClasses                   ||--o{ ClassHeatmapSummaries\nSkills                    ||--o{ ClassHeatmapSummaries\nStudents                  ||--o{ StudentDailyActivities\nStudents                  ||--o| StudentReadinessMetrics\nKnowledgeSources          ||--o{ KnowledgeVectorChunks\nSkills                    ||--o{ archetype_patterns\narchetype_patterns        ||--o{ pattern_exemplars\narchetype_patterns        ||--o{ pattern_traps\narchetype_patterns        |o--o{ novel_pattern_proposals\nStudents                  ||--o{ ai_tutor_interaction_logs\nQuestions                 ||--o{ ai_tutor_interaction_logs\narchetype_patterns        |o--o{ ai_tutor_interaction_logs\npattern_traps             |o--o{ ai_tutor_interaction_logs\n\n@enduml&quot;, &quot;config&quot;: null}" id="puml_root_wrapper">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
