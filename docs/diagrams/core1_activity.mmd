    %% =========================================================================
    %% LÀN 2: HỆ THỐNG V-EVAL (PRACTICE SERVICE)
    %% =========================================================================
    subgraph SystemLane ["Làn 2: Hệ Thống Khảo Thí (Practice Service)"]
        direction TB
        Act_LoadExam["Nạp đề thi chuẩn hóa 30 câu từ Content Service"]
        Act_AutoSubmit["Tự động thu bài và đóng phiên thi (Auto-submit)"]
        Dec_TimeCheck{"Bài thi có tạo trước đó > 24 giờ?"}
        Act_MarkExpired["Đánh dấu bài thi HẾT HẠN (EXPIRED)"]
        Act_VerifyProfile["Xác minh hồ sơ học sinh & Cơ sở qua Identity Service"]
        Act_FetchKeys["Lấy bảng đáp án gốc & Siêu dữ liệu từ Content Service"]
        Act_GradeSub["Chấm điểm 30 câu, tính độ chính xác & Gắn cờ kỹ năng yếu (< 60%)"]
        Act_SendAiPayload["Gửi dữ liệu bài làm sang Phân hệ AI Engine"]
        Act_SaveSubmission["Lưu ExamSubmissions & Cập nhật tiên nghiệm P(L0) vào LearningProfiles"]
        Dec_ClassSpace{"Cơ sở có lớp mở cùng trình độ còn chỗ (< 20 em)?"}
        Act_SelectOpenClass["Chọn lớp mở hiện có tại Campus"]
        Act_CreateNewClass["Tự động tạo lớp mới cho trình độ này tại Campus"]
        Act_EnrollClass["Ghi danh học sinh vào lớp & Cập nhật bài nộp"]
        Act_DisplayRadar["Trả về kết quả hoàn chỉnh & Hiển thị biểu đồ Radar"]
    end

    %% =========================================================================
    %% LÀN 3: PHÂN HỆ AI (AI ENGINE & PSYCHOMETRICS)
    %% =========================================================================
    subgraph AILane ["Làn 3: Phân Hệ AI (AI Engine & Psychometrics)"]
        direction TB
        Act_FilterGuess["Lọc đoán mò: Nếu thời gian < 5s, đặt phân cách a = 0.1"]
        Act_EstimateTheta["Ước lượng năng lực theta với IRT 2PL & Tối ưu Brent MAP trong [-3.0, +3.0]"]
        Act_ComputeBKT["Tính tiên nghiệm BKT P(L0) kẹp trong [0.05, 0.95] & Suy diễn kỹ năng chưa test"]
        Act_DetermineTier["Xác định phân tầng xếp lớp và tọa độ Radar 4 miền"]
        Dec_GeminiAvail{"Gemini API có phản hồi khả dụng?"}
        Act_CallGemini["Gọi Gemini API sinh lời khuyên sư phạm cá nhân hóa"]
        Act_RuleFeedback["Tự động sinh nhận xét sư phạm dựa trên tập luật (Rule-based Fallback)"]
        Act_ReturnDiag["Tổng hợp kết quả phân tích & Trả về cho Practice Service"]
    end

    %% Điều phối luồng tuần tự
    Start1A --> Act_SelectTarget
    Act_SelectTarget --> Act_ClickStartDiag
    Act_ClickStartDiag --> Act_LoadExam
    Act_LoadExam --> Act_DoExam

    Act_DoExam --> Dec_SubmitTrigger
    Dec_SubmitTrigger -->|"Học sinh bấm nộp"| Act_ClickSubmit
    Dec_SubmitTrigger -->|"Hết 45 phút"| Act_AutoSubmit

    Act_ClickSubmit --> Dec_TimeCheck
    Act_AutoSubmit --> Dec_TimeCheck

    Dec_TimeCheck -->|"Lớn hơn 24h"| Act_MarkExpired
    Act_MarkExpired --> Act_WaitExpired
    Act_WaitExpired --> Act_ClickStartDiag

    Dec_TimeCheck -->|"Hợp lệ (<= 24h)"| Act_VerifyProfile
    Act_VerifyProfile --> Act_FetchKeys
    Act_FetchKeys --> Act_GradeSub
    Act_GradeSub --> Act_SendAiPayload

    Act_SendAiPayload --> Act_FilterGuess
    Act_FilterGuess --> Act_EstimateTheta
    Act_EstimateTheta --> Act_ComputeBKT
    Act_ComputeBKT --> Act_DetermineTier
    Act_DetermineTier --> Dec_GeminiAvail

    Dec_GeminiAvail -->|"Khả dụng"| Act_CallGemini
    Dec_GeminiAvail -->|"Mất kết nối / Lỗi"| Act_RuleFeedback

    Act_CallGemini --> Act_ReturnDiag
    Act_RuleFeedback --> Act_ReturnDiag
    Act_ReturnDiag --> Act_SaveSubmission

    Act_SaveSubmission --> Dec_ClassSpace
    Dec_ClassSpace -->|"Còn chỗ (< 20)"| Act_SelectOpenClass
    Dec_ClassSpace -->|"Hết chỗ / Chưa có"| Act_CreateNewClass

    Act_SelectOpenClass --> Act_EnrollClass
    Act_CreateNewClass --> Act_EnrollClass

    Act_EnrollClass --> Act_DisplayRadar
    Act_DisplayRadar --> Act_ReviewResult
    Act_ReviewResult --> End1A
