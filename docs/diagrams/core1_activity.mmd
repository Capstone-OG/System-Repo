    %% =========================================================================
    subgraph StudentLane ["Làn 1: Học Sinh (Student)"]
        direction TB
        Start1A(("● Bắt đầu"))
        Act_SelectTarget["Chọn Cơ sở (Campus) và Điểm mục tiêu"]
        Act_ClickStartDiag["Bấm Bắt đầu làm bài thi chẩn đoán năng lực"]
        Act_DoExam["Làm bài thi 30 câu chuẩn hóa trong vòng 45 phút"]
        Dec_SubmitTrigger{"Điều kiện nộp bài là gì?"}
        Act_ClickSubmit["Học sinh chủ động bấm Nộp bài"]
        Act_WaitExpired["Được thông báo bài thi quá 24h & Bấm làm bài chẩn đoán mới"]
