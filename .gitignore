# Ignore all service sub-repositories
All Services/

# Build results and IDE files
.vs/
.idea/
*.user
*.suo
bin/
obj/

scratch/
.local_logs/

# Ignore root .env and all service configs (contain Gemini/OpenAI keys & DB credentials)
/.env
/.env.*
!/.env.example
Configs/**/appsettings.json
Configs/**/appsettings.*.json
!Configs/**/appsettings.example.json
Configs/**/.env
Configs/**/.env.*
!Configs/**/.env.example
**/*.bak

# Test results and Coverage reports
TestResults/
[Tt]est[Rr]esults/
*.cobertura.xml
