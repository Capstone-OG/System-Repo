{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "V-Eval_Secure_JWT_Key_2026_Identity_Service_Capstone_Secret!",
    "Issuer": "V-Eval-IdentityService",
    "Audience": "V-Eval-Clients",
    "RefreshThresholdMinutes": 5
  },
  "ReverseProxy": {
    "Routes": {
      "ai-engine-api-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/api/ai-engine/{**catch-all}"
        }
      },
      "ai-engine-view-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/view-exam"
        }
      },
      "ai-engine-view-diagnostic-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/view-diagnostic"
        }
      },
      "ai-engine-view-textbook-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/view-textbook"
        }
      },
      "ai-engine-static-route": {
        "ClusterId": "ai-engine-cluster",
        "Match": {
          "Path": "/extracted_images/{**catch-all}"
        }
      },
      "ai-rag-diagnostic-route": {
        "ClusterId": "ai-rag-cluster",
        "Match": {
          "Path": "/api/diagnostic/{**catch-all}"
        }
      },
      "ai-rag-diagnostic-v1-route": {
        "ClusterId": "ai-rag-cluster",
        "Match": {
          "Path": "/api/v1/diagnostic/{**catch-all}"
        }
      },
      "ai-rag-chat-route": {
        "ClusterId": "ai-rag-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "ai-rag-chat-v1-route": {
        "ClusterId": "ai-rag-cluster",
        "Match": {
          "Path": "/api/v1/chat/{**catch-all}"
        }
      },
      "ai-rag-documents-v1-route": {
        "ClusterId": "ai-rag-cluster",
        "Match": {
          "Path": "/api/v1/documents/{**catch-all}"
        }
      },
      "content-service-route": {
        "ClusterId": "content-service-cluster",
        "Match": {
          "Path": "/api/content/{**catch-all}"
        }
      },
      "content-service-v1-route": {
        "ClusterId": "content-service-cluster",
        "Match": {
          "Path": "/api/v1/content/{**catch-all}"
        }
      },
      "identity-service-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "identity-service-v1-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "identity-auth-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-auth-v1-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-users-v1-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "identity-campuses-v1-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/v1/campuses/{**catch-all}"
        }
      },
      "identity-students-v1-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/v1/students/{**catch-all}"
        }
      },
      "practice-service-route": {
        "ClusterId": "practice-service-cluster",
        "Match": {
          "Path": "/api/practice/{**catch-all}"
        }
      },
      "practice-service-v1-route": {
        "ClusterId": "practice-service-cluster",
        "Match": {
          "Path": "/api/v1/practice/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ai-engine-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "ai-rag-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000"
          }
        }
      },
      "content-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5249"
          }
        }
      },
      "identity-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5155"
          }
        }
      },
      "practice-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5261"
          }
        }
      }
    }
  }
}
