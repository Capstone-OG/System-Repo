# =====================================================================
# V-Eval System-Wide Environment Variables
# =====================================================================
# Copy this file to Configs/.env (or .env at project root):
#   cp Configs/.env.example Configs/.env
#
# Gemini API Keys (Required for curriculum extraction, OCR, and AI Tutor)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEYS=
GOOGLE_API_KEYS=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# Optional: OpenAI API Key (fallback)
OPENAI_API_KEY=

# Database URL for AI RAG Service (PostgreSQL / Supabase Pooler)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Optional: Brevo SMTP Key for Identity Service emails
BREVO_SMTP_KEY=
